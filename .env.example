# Copiar como .env y completar con tu clave

# Groq API (gratis en console.groq.com)
GROQ_API_KEY=gsk_...

# Pipeline
INPUT_PDF=input/documento.pdf
TARGET_DURATION=12

# Video
VIDEO_FPS=24
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# Audio (edge-tts, sin costo)
# Voces disponibles: es-ES-AlvaroNeural, es-ES-ElviraNeural, es-AR-ElenaNeural, es-AR-TomasNeural
TTS_VOICE=es-ES-AlvaroNeural
TTS_RATE=-10%

# Imagenes (Pollinations.ai, sin costo)
IMAGE_SEED=42
