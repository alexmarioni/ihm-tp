# ─────────────────────────────────────────────
# Cómo obtener tu GROQ_API_KEY (es gratis):
#   1. Entrá a https://console.groq.com
#   2. Creá una cuenta (no requiere tarjeta)
#   3. Menú lateral → API Keys → Create API Key
#   4. Copiá la clave (empieza con gsk_...)
# ─────────────────────────────────────────────

GROQ_API_KEY=gsk_REEMPLAZAR_CON_TU_CLAVE

# Pipeline
INPUT_PDF=input/documento.pdf
TARGET_DURATION=12

# Video
VIDEO_FPS=24
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# Audio (edge-tts, sin costo)
# Voces disponibles: es-ES-AlvaroNeural, es-ES-ElviraNeural, es-AR-ElenaNeural, es-AR-TomasNeural
TTS_VOICE=es-ES-AlvaroNeural
TTS_RATE=-10%

# Imagenes (Pollinations.ai, sin costo)
IMAGE_SEED=42
